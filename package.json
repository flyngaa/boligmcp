{
  "name": "boligmcp",
  "version": "0.1.0",
  "description": "MCP server that gathers public Danish property data from official registers for a given address.",
  "type": "module",
  "bin": {
    "boligmcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "mcp",
    "denmark",
    "property",
    "bbr",
    "adresse",
    "bolig",
    "datafordeler"
  ],
  "author": "Frederik Lyngaa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyngaa/boligmcp.git"
  },
  "bugs": {
    "url": "https://github.com/flyngaa/boligmcp/issues"
  },
  "homepage": "https://github.com/flyngaa/boligmcp#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "proj4": "^2.19.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "@types/proj4": "^2.5.6",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
