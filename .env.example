# Development only: the server reads this file when BOLIGMCP_ENV_FILE points to it (pnpm dev / pnpm smoke).
# End users run `npx -y boligmcp setup` or set these in their MCP client config instead.

# Free. datafordeler.dk → web user → IT-system → API-key. BBR, Matriklen, VUR, DAR, DAGI, DHM, GeoDanmark.
DATAFORDELER_API_KEY=

# Optional. Sale prices (EJF) after Geodatastyrelsen approves your request. OAuth Shared Secret, not the API key.
DATAFORDELER_OAUTH_CLIENT_ID=
DATAFORDELER_OAUTH_CLIENT_SECRET=

# Optional. Energy labels; needs an agreement with Energistyrelsen.
EMODATA_USER=
EMODATA_PASSWORD=

# Optional. Spring orthophoto and skråfoto dates (`get_aerial_photo`).
DATAFORSYNINGEN_TOKEN=

# Optional. Photorealistic 3D map (`get_map`). Maps JavaScript API. Allow http://127.0.0.1:47321/* if website-restricted.
GOOGLE_MAPS_API_KEY=

# Public KDS token; replace when user management ships.
ADRESSEVAELGER_TOKEN=adressevaelger123

# Defaults to ~/.cache/boligmcp/cache.db
CACHE_PATH=
