# Datafordeleren GraphQL API key (T1, free).
# Create a web user at https://datafordeler.dk, then an IT-system with API-key auth.
# Unlocks DAR, MAT, BBR, DAGI, VUR, EJF.
DATAFORDELER_API_KEY=

# Adressevælgeren token (T0). Defaults to the public KDS recommendation.
# Replace when user management ships (late 2026 / early 2027).
ADRESSEVAELGER_TOKEN=adressevaelger123

# Dataforsyningen token (T1, optional). Only needed for imagery/terrain stretch features.
DATAFORSYNINGEN_TOKEN=

# Energistyrelsen EMOData (T2). Required for get_energy_label.
EMODATA_USER=
EMODATA_PASSWORD=

# SQLite cache file. Defaults to ./cache.db
CACHE_PATH=./cache.db
