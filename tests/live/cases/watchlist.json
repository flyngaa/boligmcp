[
  {"id": "w_list_empty", "tool": "list_watchlist", "args": {}, "expect": [{"path": "entries", "equals": []}], "sequence": "watch"},
  {"id": "w_add", "tool": "watch_property", "args": {"query": "Egeskovvej 41, 8800 Viborg", "note": "first"}, "expect": [{"path": "alreadyWatched", "equals": false}, {"path": "id", "equals": "3451459"}, {"path": "$watchlist", "matches": "\"note\": \"first\""}], "sequence": "watch"},
  {"id": "w_check_unchanged", "tool": "check_watchlist", "args": {}, "expect": [{"path": "checked", "equals": 1}, {"path": "changed", "equals": 0}, {"path": "results[0].changes", "equals": []}], "sequence": "watch"},
  {"id": "w_check_changed", "tool": "check_watchlist", "args": {}, "expect": [{"path": "changed", "equals": 1}, {"path": "results[0].changes[*]", "contains": "^Ny offentlig vurdering 2022"}], "sequence": "watch", "setup": {"editWatchlist": {"path": "entries.0.snapshot.valuation.propertyValue", "value": 1}}},
  {"id": "w_check_reported_once", "tool": "check_watchlist", "args": {}, "expect": [{"path": "changed", "equals": 0}], "sequence": "watch"},
  {"id": "w_check_without_key", "tool": "check_watchlist", "args": {}, "expect": [{"path": "changed", "equals": 0, "why": "S1: failed sources read as removed plans and buildings"}, {"path": "results[0].notChecked", "contains": "^buildings$"}], "sequence": "watch", "env": "no_credentials"},
  {"id": "w_check_after_no_key", "tool": "check_watchlist", "args": {}, "expect": [{"path": "changed", "equals": 0, "why": "baseline was not overwritten by the keyless check"}], "sequence": "watch"},
  {"id": "w_rewatch", "tool": "watch_property", "args": {"query": "Egeskovvej 41, 8800 Viborg", "note": "second"}, "expect": [{"path": "alreadyWatched", "equals": true}, {"path": "$watchlist", "matches": "\"note\": \"second\""}, {"path": "$watchlist", "notMatches": "\"note\": \"first\""}], "sequence": "watch"},
  {"id": "w_mismatch_refused", "tool": "watch_property", "args": {"query": "Istedgade 50, 3. th, 1650 København V"}, "expect": [{"path": "error", "matches": "Nothing was added"}, {"path": "$watchlist", "notMatches": "Istedgade"}], "sequence": "watch"},
  {"id": "w_mismatch_allowed", "tool": "watch_property", "args": {"query": "Istedgade 50, 3. th, 1650 København V", "allowMismatch": true}, "expect": [{"path": "alreadyWatched", "equals": false}, {"path": "matchWarning", "matches": "etage 3"}, {"path": "$watchlist", "matches": "Istedgade 50, st\\."}], "sequence": "watch"},
  {"id": "w_list_two", "tool": "list_watchlist", "args": {}, "expect": [{"path": "entries.length", "equals": 2}], "sequence": "watch"},
  {"id": "w_unwatch_designation", "tool": "unwatch_property", "args": {"id": "ISTEDGADE 50, ST., 1650 KØBENHAVN V"}, "expect": [{"path": "removed", "equals": 1}, {"path": "remaining", "equals": 1}], "sequence": "watch"},
  {"id": "w_unwatch_address_id", "tool": "unwatch_property", "args": {"id": "0A3F50C6-588F-32B8-E044-0003BA298018"}, "expect": [{"path": "removed", "equals": 1}, {"path": "remaining", "equals": 0}], "sequence": "watch"},
  {"id": "w_add_without_key", "tool": "watch_property", "args": {"query": "Egeskovvej 41, 8800 Viborg"}, "expect": [{"path": "alreadyWatched", "equals": false}, {"path": "id", "equals": "0a3f50c6-588f-32b8-e044-0003ba298018"}], "sequence": "watch", "env": "no_credentials"},
  {"id": "w_add_with_key", "tool": "watch_property", "args": {"query": "Egeskovvej 41, 8800 Viborg"}, "expect": [{"path": "alreadyWatched", "equals": true}, {"path": "id", "equals": "3451459"}, {"path": "$watchlist", "matches": "\"id\": \"3451459\""}, {"path": "$watchlist", "notMatches": "\"id\": \"0a3f50c6-588f-32b8-e044-0003ba298018\""}], "sequence": "watch"},
  {"id": "w_one_entry", "tool": "list_watchlist", "args": {}, "expect": [{"path": "entries.length", "equals": 1}, {"path": "entries[0].id", "equals": "3451459"}], "sequence": "watch"},
  {"id": "w_unwatch_query", "tool": "unwatch_property", "args": {"id": "  egeskovvej 41, 8800 viborg "}, "expect": [{"path": "removed", "equals": 1}], "sequence": "watch"},
  {"id": "w_corrupt_list", "tool": "list_watchlist", "args": {}, "expect": [{"path": "error", "matches": "not valid JSON"}, {"path": "$watchlist", "equals": "{not json"}], "sequence": "watch", "setup": {"watchlist": "{not json"}},
  {"id": "w_corrupt_watch", "tool": "watch_property", "args": {"query": "Egeskovvej 41, 8800 Viborg"}, "expect": [{"path": "error", "matches": "not valid JSON"}, {"path": "$watchlist", "equals": "{not json"}], "sequence": "watch"},
  {"id": "w_corrupt_unwatch", "tool": "unwatch_property", "args": {"id": "3451459"}, "expect": [{"path": "error", "matches": "left untouched"}, {"path": "$watchlist", "equals": "{not json"}], "sequence": "watch"},
  {"id": "w_no_entries_list", "tool": "check_watchlist", "args": {}, "expect": [{"path": "error", "matches": "no \"entries\" list"}, {"path": "$watchlist", "equals": "{\"items\":[]}"}], "sequence": "watch", "setup": {"watchlist": {"items": []}}}
]
